# AgroNex Bangladesh - Server-Side Environment Variables
# Add your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# In Vercel, add this under: Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
